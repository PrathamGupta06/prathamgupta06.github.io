---
import SectionHeading from "./SectionHeading.astro";
import iitmLogo from "../assets/education/iitm.png";
import maitLogo from "../assets/education/mait.jpeg";

const education = [
  {
    institution: "Indian Institute of Technology, Madras",
    degree: "Bachelor of Science in Data Science and Applications",
    period: "2023 – 2027 (Expected)",
    cgpa: "9.53",
    logo: iitmLogo,
    logoClass: "object-contain",
  },
  {
    institution: "Maharaja Agrasen Institute of Technology",
    degree: "Bachelor of Technology in Computer Science Technology",
    period: "2023 – 2027 (Expected)",
    cgpa: "9.45",
    logo: maitLogo,
    logoClass: "object-cover rounded-md",
  },
];
---

<section class="py-24 space-y-12 px-5" id="education">
  <SectionHeading title="Education" />

  <div class="max-w-4xl mx-auto space-y-6">
    {
      education.map((item) => (
        <div class="bg-white p-6 border-2 flex flex-col sm:flex-row sm:items-center gap-4">
          <img src={item.logo.src} alt="" class={`w-12 h-12 flex-shrink-0 ${item.logoClass}`} />
          <div class="flex-1">
            <h3 class="text-xl md:text-2xl font-medium">{item.institution}</h3>
            <p class="text-base md:text-lg mt-1">{item.degree}</p>
            <p class="text-sm text-gray-600 mt-1">{item.period}</p>
          </div>
          <div class="self-start sm:self-center px-4 py-2 border-2 bg-(--yellow) text-center">
            <p class="text-xs uppercase font-medium">CGPA</p>
            <p class="text-2xl font-bold">{item.cgpa}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
