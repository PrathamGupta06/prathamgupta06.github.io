---
import Button from "./Button.astro";
import Bars from "./Bars.astro";
import { author } from "../sample";
---

<section class="px-5 py-24 bg-(--alt-bg)" id="contact">
  <div class="max-w-3xl mx-auto bg-white text-center flex flex-col items-center gap-5 border-3 shadow-[8px_8px_0px_rgba(0,0,0,0.3)] relative p-8 md:p-12">
    <h2 class="text-3xl md:text-4xl font-medium">Get in touch</h2>
    <p class="text-lg max-w-xl">
      Have an interesting idea or problem in AI, or just want to talk shop?
      My inbox is always open.
    </p>

    <a
      href={author.email}
      data-ga="contact_click"
      data-ga-method="email"
      data-ga-location="contact"
      class="text-xl md:text-2xl font-bold break-all underline decoration-(--yellow) decoration-4 underline-offset-6 hover:bg-(--yellow)"
    >
      {author.emailAddress}
    </a>

    <div class="flex flex-wrap justify-center gap-x-8 gap-y-4 mt-3">
      <Button text="Email me" link={author.email} data-ga="contact_click" data-ga-method="email" data-ga-location="contact" />
      <Button text="LinkedIn" link={author.linkedin} target="_blank" variant="secondary" data-ga="social_click" data-ga-network="linkedin" data-ga-location="contact" />
      <Button text="GitHub" link={author.github} target="_blank" variant="secondary" data-ga="social_click" data-ga-network="github" data-ga-location="contact" />
    </div>
    <Bars />
  </div>
</section>
