---
import SectionHeading from "./SectionHeading.astro"

const skillCategories = [
  {
    category: 'Languages',
    skills: ['Python', 'C/C++', 'SQL', 'JavaScript'],
  },
  {
    category: 'AI / ML',
    skills: ['LangChain', 'LangGraph', 'RAG', 'Multi-Agent Systems', 'Computer Vision', 'ONNX', 'Model Fine-tuning', 'NumPy', 'pandas'],
  },
  {
    category: 'Web & Backend',
    skills: ['FastAPI', 'Django', 'Flask', 'React.js', 'Next.js', 'Astro'],
  },
  {
    category: 'Cloud & DevOps',
    skills: ['Microsoft Azure', 'Google Cloud', 'Docker', 'Kubernetes', 'GitHub Actions', 'Firebase', 'Cloudflare', 'Linux', 'Git'],
  },
]
---

<section class="py-24 space-y-12 px-5 bg-(--alt-bg)" id="skills">
  <SectionHeading title="Technical Skills" />

  <dl class="max-w-4xl mx-auto bg-white border-2 divide-y-2">
    {skillCategories.map((category) => (
      <div class="flex flex-col md:flex-row gap-3 md:gap-6 p-5">
        <dt class="md:w-40 flex-shrink-0 font-bold pt-1">{category.category}</dt>
        <dd class="flex flex-wrap gap-2">
          {category.skills.map((skill) => (
            <span class="px-3 py-1 border-2 text-sm bg-(--main-bg)">{skill}</span>
          ))}
        </dd>
      </div>
    ))}
  </dl>
</section>
