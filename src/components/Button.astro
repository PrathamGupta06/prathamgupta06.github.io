---
const { text, link, target, variant = "primary", ...attrs } = Astro.props

import svgHl from '../assets/hl.svg'

const bg = variant === "primary" ? "bg-(--blue)" : "bg-white"
---

<div class="relative group">
   <a
      href={link}
      target={target}
      rel={target === "_blank" ? "noopener noreferrer" : undefined}
      {...attrs}
      class={`${bg} text-black text-md font-medium flex items-center h-12 px-6 border-3 rounded-full transition-shadow duration-200 hover:shadow-[3px_3px_0px_rgba(0,0,0,1)]`}
   >{text}</a>
   {variant === "primary" && (
      <img src={svgHl.src} width="30" alt="" class="absolute -right-7 -bottom-3 transition-all duration-200 group-hover:-bottom-4" />
   )}
</div>
