---
import Bars from "./Bars.astro";
import SectionHeading from "./SectionHeading.astro";

const featured = [
  {
    kicker: "ACM ICPC",
    headline: "Asia West Regionalist",
    detail: "Qualified for regionals twice, in 2024 and 2025",
    extra: "CodeChef max rating 1809 (4★)",
    icon: "ri-code-s-slash-line",
    color: "var(--yellow)",
  },
  {
    kicker: "GATE DS & AI",
    headline: "All India Rank 104",
    detail: "Among 91,000+ candidates",
    icon: "ri-bar-chart-box-line",
    color: "var(--blue)",
  },
  {
    kicker: "HackRX 6.0 · Bajaj Finserv",
    headline: "Winner, Darkhorse Award",
    detail: "Top 4 of 10,000+ participants",
    icon: "ri-trophy-line",
    color: "var(--pink)",
  },
];

const others = [
  { place: "2nd", title: "Cognizance Hackathon", detail: "IIT Roorkee" },
  { place: "3rd", title: "GooseCTF", detail: "Warwick Cyber Security Society (international)" },
  { place: "Top 10", title: "National Level Pentathon 2024", detail: "NCIIPC × AICTE" },
  { place: "Rank 4", title: "International Olympiad of Mathematics", detail: "Silverzone Foundation (Level 1)" },
  { place: "3rd", title: "Mathematical R&D Paper Presentation", detail: "9th International Young Mathematician's Convention" },
];
---

<section class="py-24 space-y-12 px-5" id="achievements">
  <SectionHeading title="Awards & Competitions" />

  <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8">
    {
      featured.map((item) => (
        <div class="bg-white p-6 border-2 relative flex flex-col">
          <div
            class="w-12 h-12 flex items-center justify-center text-2xl mb-5 border-2"
            style={`background-color: ${item.color}`}
          >
            <i class={item.icon} />
          </div>
          <p class="text-xs uppercase font-bold tracking-wider text-gray-600">{item.kicker}</p>
          <h3 class="text-2xl font-bold mt-1">{item.headline}</h3>
          <p class="text-sm text-gray-700 mt-2">{item.detail}</p>
          {item.extra && (
            <p class="text-sm font-medium mt-4 pt-3 border-t-2 border-dashed">{item.extra}</p>
          )}
          <Bars />
        </div>
      ))
    }
  </div>

  <ul class="max-w-5xl mx-auto bg-white border-2 divide-y-2">
    {
      others.map((item) => (
        <li class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-6 px-5 py-4">
          <span class="sm:w-20 flex-shrink-0 font-bold">{item.place}</span>
          <span class="font-medium flex-1">{item.title}</span>
          <span class="text-sm text-gray-600">{item.detail}</span>
        </li>
      ))
    }
  </ul>
</section>
