---
import { author } from "../sample";

const socials = [
  { icon: "ri-github-fill", link: author.github, label: "GitHub" },
  { icon: "ri-linkedin-box-fill", link: author.linkedin, label: "LinkedIn" },
  { icon: "ri-mail-line", link: author.email, label: "Email" },
];
---

<footer class="border-t-4 px-5 md:px-0 py-10">
  <div
    class="max-w-3xl mx-auto flex flex-col md:flex-row gap-5 justify-between items-center"
  >
    <p class="text-center">
      © {new Date().getFullYear()} {author.nickname}. All rights reserved.
    </p>
    <div class="flex gap-5">
      {
        socials.map((item) => (
          <a
            href={item.link}
            target={item.link.startsWith("http") ? "_blank" : undefined}
            rel="noopener noreferrer"
            aria-label={item.label}
            class="transition-all duration-200 hover:translate-y-0.5"
          >
            <i class={`${item.icon} text-2xl`} />
          </a>
        ))
      }
    </div>
  </div>
</footer>
