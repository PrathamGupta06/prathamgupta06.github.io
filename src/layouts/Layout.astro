---
import { author } from "../sample";
import profile from "../assets/profile.jpg";

const gaId = "G-FFWGWCFEHS";

const title = `${author.name} | ${author.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(profile.src, Astro.site).href;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: author.name,
  jobTitle: author.tagline,
  url: Astro.site?.href,
  image: ogImage,
  sameAs: [author.github, author.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={author.description} />
    <meta name="author" content={author.name} />
    <title>{title}</title>

    <!-- Open Graph / Social Media Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={author.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={author.description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    {
      import.meta.env.PROD && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", gaId);
          </script>
        </>
      )
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  // Elements opt in with data-ga="<event_name>"; any data-ga-* attributes
  // become event parameters (data-ga-location -> location).
  const track = (name: string, params: Record<string, string> = {}) => {
    (window as any).gtag?.("event", name, params);
  };

  document.addEventListener("click", (e) => {
    const el = (e.target as Element).closest<HTMLElement>("[data-ga]");
    if (!el) return;

    const params: Record<string, string> = {};
    for (const [key, value] of Object.entries(el.dataset)) {
      if (key.startsWith("ga") && key !== "ga" && value) {
        const name = key.slice(2);
        params[name[0].toLowerCase() + name.slice(1)] = value;
      }
    }
    track(el.dataset.ga!, params);
  });

  // Fire section_view once per section per visit.
  const seen = new Set<string>();
  const sectionObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting || seen.has(entry.target.id)) continue;
        seen.add(entry.target.id);
        track("section_view", { section: entry.target.id });
      }
    },
    { threshold: 0.4 },
  );
  document
    .querySelectorAll("section[id]")
    .forEach((section) => sectionObserver.observe(section));
</script>

<style is:global>
  :root {
    --main-bg: #fefff0;
    --alt-bg: #f7f5df;
    --blue: #bae6ff;
    --yellow: #ffdc58;
    --pink: #ffb6d9;
    --green: #22c55e;
  }

  html,
  body {
    margin: 0;
    width: 100%;
    background-color: var(--main-bg);
    font-family: "Space Grotesk", sans-serif;
    scroll-behavior: smooth;
    scroll-padding-top: 100px; /* Offset for fixed header */
  }
</style>
